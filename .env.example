# Postgres connection string used by drizzle-kit and the app.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/orqenta

# Bootstrap admin, created on first boot if the users table is empty.
# The app fails fast at boot if either of these is missing or blank.
ADMIN_USER=admin
ADMIN_PASS=supersecret

# Session signing key — required, non-empty. Generate a real one per environment.
JWT_SECRET=change-me
# Session lifetime in seconds, 300–43200.
SESSION_TTL_SECONDS=3600
# Leave true anywhere the app is served over HTTPS.
COOKIE_SECURE=true

# Login rate limiting.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_WINDOW_SECONDS=900
